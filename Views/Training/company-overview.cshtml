@{
    Layout = "_TrainingLayout";
}

<div class="training-title">
    <i class="bi bi-building text-primary"></i>
    Company Overview
</div>

<p class="training-subtitle">
    Welcome to <strong>Founders Desk</strong>. This training helps you understand who we are,
    what we value, and how we work together as a team.
</p>

<div class="mb-4">
    <div class="section-title">
        <i class="bi bi-bullseye text-danger me-1"></i>
        Our Mission
    </div>
    <p>
        To empower founders by delivering reliable, scalable, and innovative solutions
        that enable sustainable business growth.
    </p>
</div>

<div class="mb-2">
    <div class="section-title">
        <i class="bi bi-people-fill text-warning me-1"></i>
        Our Culture
    </div>
    <ul class="training-list">
        <li>Ownership & accountability</li>
        <li>Continuous learning</li>
        <li>Transparency & trust</li>
    </ul>
</div>

<div class="training-nav">
    <span></span>
    <a asp-controller="Training"
       asp-action="Index"
       asp-route-pageKey="frontend-basics"
       class="btn btn-primary btn-nav">
        Next <i class="bi bi-arrow-right"></i>
    </a>

    </a>
</div>
