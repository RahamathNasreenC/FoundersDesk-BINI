@model FoundersDesk.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard - Founder's Desk";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #0e0e0e;
            min-height: 100vh;
            color: #ffffff;
            margin: 0;
        }

        .header {
            background: linear-gradient(135deg, #0099b8 0%, #2b1f62 100%);
            padding: 20px 40px;
            position: relative; /* add this */
            z-index: 10;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo {
            width: 50px;
            height: 50px;
            background: #3eaecb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 20px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logout-btn {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

            .logout-btn:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: translateY(-2px);
            }

        .main-container {
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .about-section {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            padding: 60px 40px;
            border-radius: 20px;
            margin-bottom: 60px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .about-title {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 30px;
            color: #3eaecb;
        }

        .about-text {
            font-size: 18px;
            line-height: 1.8;
            color: #cccccc;
            max-width: 800px;
            margin: 0 auto 40px;
        }

        .founder-section {
            display: flex;
            align-items: center;
            gap: 30px;
            justify-content: center;
            margin-top: 40px;
        }

        .founder-photo {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3eaecb 0%, #8970ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: bold;
            color: white;
        }

        .founder-message {
            text-align: left;
            max-width: 500px;
        }

            .founder-message h3 {
                font-size: 24px;
                margin-bottom: 15px;
                color: #3eaecb;
            }

            .founder-message p {
                font-size: 16px;
                line-height: 1.6;
                color: #cccccc;
            }

        .learning-section {
            background: linear-gradient(135deg, #2b1f62 0%, #1a1a2e 100%);
            padding: 60px 40px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .platform-section {
            background: linear-gradient(135deg, #2b1f62 0%, #1a1a2e 100%);
            padding: 60px 40px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .section-title {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #3eaecb;
            text-align: center;
        }

        .section-description {
            font-size: 18px;
            color: #cccccc;
            text-align: center;
            margin-bottom: 50px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .video-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            border: 1px solid rgba(62, 174, 203, 0.3);
        }

            .video-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 40px rgba(62, 174, 203, 0.3);
                border-color: #3eaecb;
            }

        .video-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #3eaecb 0%, #47c6e7 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 32px;
        }

        .video-card h3 {
            font-size: 22px;
            margin-bottom: 15px;
            color: #ffffff;
        }

        .video-card p {
            font-size: 14px;
            color: #cccccc;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .video-btn {
            background: linear-gradient(135deg, #0099b8 0%, #2b1f62 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .video-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(0, 153, 184, 0.4);
            }

        .quick-links {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .quick-link {
            background: rgba(71, 198, 231, 0.1);
            border: 1px solid #47c6e7;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            text-decoration: none;
            color: #47c6e7;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .quick-link:hover {
                background: rgba(71, 198, 231, 0.2);
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(71, 198, 231, 0.3);
            }

        .success-stories {
            margin-top: 50px;
            text-align: center;
        }

            .success-stories h3 {
                font-size: 24px;
                color: #3eaecb;
                margin-bottom: 20px;
            }

        .story-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-top: 30px;
        }

        .story-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            padding: 25px;
            border-left: 4px solid #47c6e7;
        }

            .story-card h4 {
                color: #3eaecb;
                margin-bottom: 10px;
                font-size: 18px;
            }

            .story-card p {
                color: #cccccc;
                line-height: 1.6;
                font-size: 14px;
            }

        @@media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 20px;
            }

            .main-container {
                padding: 20px 15px;
            }

            .about-section, .platform-section {
                padding: 40px 20px;
            }

            .founder-section {
                flex-direction: column;
                text-align: center;
            }

            .founder-message {
                text-align: center;
            }

            .video-grid {
                grid-template-columns: 1fr;
            }

            .about-title {
                font-size: 28px;
            }

            .section-title {
                font-size: 24px;
            }
        }

        .profile-menu {
            position: relative;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid white;
        }

        .profile-dropdown {
            position: absolute;
            right: 0;
            top: 55px;
            width: 260px;
            background: #1c1c1c;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            padding: 15px;
            z-index: 1000;
        }

        .profile-dropdown-header {
            text-align: center;
        }

            .profile-dropdown-header img {
                width: 70px;
                height: 70px;
                border-radius: 50%;
                margin-bottom: 10px;
            }

        .edit-profile-btn, .logout-link {
            display: block;
            text-align: center;
            margin-top: 10px;
            padding: 10px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
        }

        .edit-profile-btn {
            background: linear-gradient(135deg, #3eaecb, #2b1f62);
            color: white;
        }

        .logout-link {
            color: #ff6b6b;
        }

        .profile-dropdown.hidden {
            display: none;
        }
        /* ===== Resource Status UI ===== */

        .pending-badge {
            background: #ff6b6b;
            color: white;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 999px;
            margin-left: 8px;
            font-weight: 700;
        }

        .completed-badge {
            background: #22c55e;
            color: #052e16;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 999px;
            margin-left: 8px;
            font-weight: 700;
        }

        .resource-pending {
            border-left: 5px solid #ff6b6b !important;
        }

        .resource-completed {
            border-left: 5px solid #22c55e !important;
        }
        /* Center Signature Card */
        .signature-row {
            grid-column: 1 / -1;
            display: flex;
            justify-content: center;
        }

            .signature-row .video-card {
                max-width: 420px;
                width: 100%;
            }

        html, body {
            width: 100%;
            overflow-x: hidden;
        }
        /* ================= VIDEO LEARNING PLAYER (Skillnation-like) ================= */

        .learning-player {
            margin-top: 60px;
        }

            .learning-player.hidden {
                display: none;
            }

        .player-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 30px;
        }

        /* LEFT PLAYLIST */
        .playlist {
            background: #111;
            border-radius: 14px;
            padding: 20px;
            height: 75vh;
            overflow-y: auto;
            border: 1px solid #333;
        }

        /* Playlist items (we will inject later via JS) */
        .playlist-item {
            padding: 12px 14px;
            border-radius: 10px;
            margin-bottom: 10px;
            cursor: pointer;
            background: #1a1a1a;
            border: 1px solid #222;
            transition: 0.2s;
            font-size: 14px;
            color: #ccc;
        }

            .playlist-item:hover {
                background: #222;
                border-color: #3eaecb;
            }

            .playlist-item.active {
                background: linear-gradient(135deg, #3eaecb, #2b1f62);
                color: white;
                font-weight: 600;
            }

        /* RIGHT PLAYER */
        .player-area {
            background: #000;
            border-radius: 14px;
            padding: 20px;
            border: 1px solid #3eaecb;
            display: flex;
            flex-direction: column;
        }

            .player-area h3 {
                color: #3eaecb;
                margin-bottom: 10px;
            }

            .player-area p {
                color: #aaa;
                font-size: 14px;
            }

        #mainVideoPlayer {
            width: 100%;
            margin-top: 15px;
            border-radius: 10px;
            flex: 1;
            background: black;
        }




    </style>
</head>
<body>
    <header class="header">
        <div class="header-content">
            <div class="logo-section">
                <div class="logo">FD</div>
                <div>
                    <h2 style="color: white; font-size: 18px;">Founder's Desk</h2>
                    <p style="color: rgba(255, 255, 255, 0.8); font-size: 14px;">Staff Dashboard</p>
                </div>
            </div>
            <div class="user-info" style="position: relative;">
                <div id="profileAvatar" onclick="toggleProfileModal()"
                     style="
        width:45px;
        height:45px;
        border-radius:50%;
        background:linear-gradient(135deg,#3eaecb,#6a5cff);
        display:flex;
        align-items:center;
        justify-content:center;
        color:white;
        font-weight:bold;
        font-size:18px;
        cursor:pointer;
        border:2px solid #3eaecb;
        user-select:none;
     ">
                    @Model.User.FullName.Substring(0, 1).ToUpper()
                </div>


                <div id="profileModal" style="display:none; position:absolute; right:0; top:60px; background:#1a1a1a; border:1px solid #3eaecb; border-radius:12px; padding:20px; width:260px; box-shadow:0 10px 30px rgba(0,0,0,0.6); z-index:1000;">
                    <div style="text-align:center; margin-bottom:15px;">
                        <div style="
    width:65px;
    height:65px;
    border-radius:50%;
    background:linear-gradient(135deg,#3eaecb,#6a5cff);
    display:flex;
    align-items:center;
    justify-content:center;
    color:white;
    font-weight:bold;
    font-size:26px;
    margin:auto;
    margin-bottom:10px;
">
                            @Model.User.FullName.Substring(0, 1).ToUpper()
                        </div>

                        <h4 style="color:white; margin:0; font-size:16px; font-weight:700;">
                            @Model.User.FullName
                        </h4>

                        @if (string.IsNullOrEmpty(Model.User.JobRole))
                        {
                            <p style="color:#ff6b6b; font-size:12px; margin-top:4px;">
                                Role not assigned
                            </p>
                        }
                        else
                        {
                            <p style="color:#3eaecb; font-size:12px; margin-top:4px; font-weight:600;">
                                @Model.User.JobRole
                            </p>
                        }

                        <p style="color:#888; font-size:12px; margin-top:4px;">
                            @Model.User.Email
                        </p>


                    </div>

                    <div style="text-align:center; margin-top:6px;">
                        <p style="color:#888; font-size:12px; margin-top:4px;">
                            <span style="margin-right:6px;">📞</span> @Model.User.PhoneNumber
                        </p>
                    </div>

                    <hr style="border:none; border-top:1px solid #333; margin:15px 0;">

                    <a href="/Profile/Complete"
                       style="
     display:block;
     text-align:center;
     color:#aaa;
     margin-top:8px;
     text-decoration:none;
     font-size:12px;
   ">
                        Edit Profile
                    </a>

                    <a href="/Auth/Logout"
                       style="
     display:block;
     text-align:center;
     color:#ff6b6b;
     margin-top:12px;
     text-decoration:none;
     font-size:13px;
     font-weight:600;
   ">
                        Logout
                    </a>

                </div>
            </div>

        </div>
    </header>

    <main class="main-container">


        <section class="about-section">
            <h1 class="about-title">About Founder's Desk</h1>
            <p class="about-text">
                Founder's Desk is a comprehensive platform designed to bridge the gap between ambitious interns and innovative businesses.
                We create meaningful partnerships that drive growth, foster learning, and build the foundation for tomorrow's success stories.
                Our platform connects talent with opportunity, creating a ecosystem where both vendors and interns can thrive and achieve their goals.
            </p>

            <div class="founder-section">
                <div class="founder-photo">FD</div>
                <div class="founder-message">
                    <h3>Founder's Vision</h3>
                    <p>
                        "Our vision is to create a world where every passionate individual finds their perfect opportunity,
                        and every business discovers the talent that drives their innovation forward. Together, we're not just
                        building careers—we're building the future."
                    </p>
                </div>
            </div>
        </section>
        <section class="learning-section" style="margin-bottom:60px;">
            <h2 class="section-title">
                Company Policies
            </h2>
            <p class="section-description">
                Please review and acknowledge the following company policy documents.
            </p>

            <div class="video-grid">

                <!-- TERMS -->
                @{
                    bool termsDone = Model.AcknowledgedResources.Contains("terms");
                }
                <div class="video-card @(termsDone ? "resource-completed" : "resource-pending")">
                    <div class="video-icon">📄</div>
                    <h3>
                        Terms & Conditions
                        @if (!termsDone)
                        {
                            <span class="pending-badge">Pending</span>
                        }
                        else
                        {
                            <span class="completed-badge">Completed</span>
                        }
                    </h3>
                    <p>Understand the rules, responsibilities, and expectations during your internship.</p>
                    <button class="video-btn" onclick="openResource('terms')">View Document</button>
                </div>

                <!-- PRIVACY -->
                @{
                    bool privacyDone = Model.AcknowledgedResources.Contains("privacy");
                }
                <div class="video-card @(privacyDone ? "resource-completed" : "resource-pending")">
                    <div class="video-icon">🔒</div>
                    <h3>
                        Privacy Policy
                        @if (!privacyDone)
                        {
                            <span class="pending-badge">Pending</span>
                        }
                        else
                        {
                            <span class="completed-badge">Completed</span>
                        }
                    </h3>
                    <p>Learn how your personal data is handled and protected by Founder's Desk.</p>
                    <button class="video-btn" onclick="openResource('privacy')">View Document</button>
                </div>

                <!-- CONDUCT -->
                @{
                    bool conductDone = Model.AcknowledgedResources.Contains("conduct");
                }
                <div class="video-card @(conductDone ? "resource-completed" : "resource-pending")">
                    <div class="video-icon">🤝</div>
                    <h3>
                        Code of Conduct
                        @if (!conductDone)
                        {
                            <span class="pending-badge">Pending</span>
                        }
                        else
                        {
                            <span class="completed-badge">Completed</span>
                        }
                    </h3>
                    <p>Guidelines to maintain professionalism, ethics, and mutual respect.</p>
                    <button class="video-btn" onclick="openResource('conduct')">View Document</button>
                </div>
                @{
                    TimeZoneInfo istZone = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
                    DateTime? signatureIST = Model.SignatureUploadedAt.HasValue
                    ? TimeZoneInfo.ConvertTimeFromUtc(Model.SignatureUploadedAt.Value, istZone)
                    : (DateTime?)null;
                }

                <!-- SIGNATURE -->
                @{
                    bool signatureDone = Model.IsSignatureUploaded;
                }
                <div class="signature-row">
                    <div class="video-card @(signatureDone ? "resource-completed" : "resource-pending")">

                        <div class="video-icon">✍️</div>

                        <h3>
                            Digital Signature
                            @if (!signatureDone)
                            {
                                <span class="pending-badge">Pending</span>
                            }
                            else
                            {
                                <span class="completed-badge">Completed</span>
                            }
                        </h3>

                        <p>
                            @if (!signatureDone)
                            {
                                <span>Please upload your digital signature.</span>
                            }
                            else
                            {
                                <span>
                                    Uploaded on @signatureIST?.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                            }
                        </p>

                        <button class="video-btn"
                                onclick="openSignatureModal()"
                                @(signatureDone ? "disabled style='opacity:0.6;cursor:not-allowed;'" : "")>
                            Upload Signature
                        </button>

                    </div>
                </div>



            </div>

        </section>

        <section class="platform-section">
            <h2 class="section-title">Welcome Kit</h2>
            <p class="section-description">
                These videos are specially curated for your job role: <b>@Model.User.JobRole</b>
            </p>

            <div class="video-grid">
                @foreach (var course in Model.Courses)
                {
                    <div class="video-card">
                        <div class="video-icon">🎓</div>

                        <h3>@course.Title</h3>
                        <p>@course.Description</p>

                        <button class="video-btn"
                                onclick="openCourse(@course.CourseId)">
                            ▶ Start Learning
                        </button>
                    </div>
                }
            </div>
        </section>


            <!-- ================= VIDEO LEARNING LAYOUT ================= -->
            <!-- ✅ MUST BE OUTSIDE LOOP -->
            

      

        



            <div class="quick-links">
                <a href="#" class="quick-link" onclick="alert('Feature coming soon!'); return false;">📋 Business Analytics</a>
                <a href="#" class="quick-link" onclick="alert('Feature coming soon!'); return false;">👥 Partner Network</a>
                <a href="#" class="quick-link" onclick="alert('Feature coming soon!'); return false;">📞 Support Center</a>
                <a href="#" class="quick-link" onclick="alert('Feature coming soon!'); return false;">💬 WhatsApp Business</a>
            </div>

            <div class="success-stories">
                <h3>Success Stories</h3>
                <div class="story-grid">
                    <div class="story-card">
                        <h4>TechCorp Solutions</h4>
                        <p>"Founder's Desk helped us find incredible interns who brought fresh perspectives and innovative solutions to our projects. Our productivity increased by 40% within the first quarter."</p>
                    </div>
                    <div class="story-card">
                        <h4>FoodieHub Restaurant</h4>
                        <p>"The platform's menu management system and analytics helped us optimize our offerings. We saw a 60% increase in customer satisfaction and 35% growth in revenue."</p>
                    </div>
                    <div class="story-card">
                        <h4>StartupVenture Inc.</h4>
                        <p>"We discovered talented individuals who became integral parts of our team. The quality of candidates and the ease of management exceeded our expectations completely."</p>
                    </div>
                </div>
            </div>
        

    </main>

    


    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>


    <!-- Resource Modal -->
    <div id="resourceModal" style="
    display:none;
    position:fixed;
    inset:0;
    width:100vw;
    height:100vh;
    background:rgba(0,0,0,0.85);
    z-index:99999;
    align-items:center;
    justify-content:center;
">



        <div style="
    background:#111;
    border:1px solid #3eaecb;
    border-radius:14px;
    width:90vw;
    height:90vh;
    padding:20px;
    color:white;
    display:flex;
    flex-direction:column;
">

            <h3 id="resourceTitle" style="color:#3eaecb;"></h3>

            <!-- PDF AREA -->
            <div style="
    flex:1;
    overflow:hidden;
    border:1px solid #333;
    border-radius:10px;
    margin-bottom:15px;
">
                <iframe id="resourceFrame"
                        src=""
                        style="width:100%; height:100%; border:none; border-radius:10px;">
                </iframe>
            </div>

            <!-- FOOTER -->
            <div style="
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding-top:10px;
    border-top:1px solid #333;
">

                <!-- CHECKBOX -->
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                    <input type="checkbox" id="ackCheckbox" style="transform:scale(1.2);" />
                    <span>I have read and understood this document</span>
                </label>

                <!-- BUTTONS -->
                <div style="display:flex; gap:12px;">
                    <button type="button" onclick="closeResourceModal()" class="video-btn" style="background:#444;">Close</button>
                    <button type="button" onclick="submitAcknowledgement()" class="video-btn">Submit</button>
                </div>

            </div>


        </div>
    </div>

    <!-- Signature Modal -->
    <div id="signatureModal" style="
    display:none;
    position:fixed;
    inset:0;
